---
import ImageCarousel from '../components/ImageCarousel.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import ExperienceEducation from '../components/ExperienceEducation.astro';
import { habilidades, proyectosIA, proyectosPrincipales } from '../data/portfolio';
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Facundo Mesa | Software Developer</title>
    <style>
      /* EFECTO DE DESVANECIMIENTO AL SCROLLEAR */
      @supports (animation-timeline: view()) {
        .sticky-hero {
          animation: fadeAndScale linear both;
          animation-timeline: view();
          animation-range: exit 0% exit 100%;
        }

        @keyframes fadeAndScale {
          to {
            opacity: 0;
            transform: scale(0.92);
            filter: blur(10px);
          }
        }
      }

      dialog::backdrop {
        background: rgba(0, 0, 0, 0.88);
        backdrop-filter: blur(8px);
      }
    </style>
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen font-sans selection:bg-neutral-800 selection:text-white relative">
    
    <!-- GLOW DE FONDO -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-tr from-indigo-600/15 via-sky-500/10 to-transparent blur-3xl pointer-events-none rounded-full -z-10"></div>

    <div class="max-w-5xl mx-auto px-6 sm:px-10">
      
      <Hero />

      <!-- CAPA SUPERIOR QUE SE SUPERPONE AL HACER SCROLL (z-10 y background sólido) -->
      <main id="contenido" class="relative z-10 bg-neutral-950 pt-24 pb-32 space-y-32 rounded-t-[3rem] border-t border-neutral-800/80 shadow-[0_-30px_60px_rgba(0,0,0,0.9)] -mx-6 sm:-mx-10 px-6 sm:px-10">

        <Profile />

        <ExperienceEducation />
        
        <!-- SECCIÓN 1: PROYECTOS DESTACADOS -->
        <section id="proyectos-destacados" class="space-y-12 scroll-mt-10">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-neutral-800 pb-6">
            <div>
              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                Proyectos Destacados
              </h2>
              <p class="text-base text-neutral-400 mt-2">
                Sistemas backend, soluciones enterprise y algoritmos de bajo nivel.
              </p>
            </div>
            <span class="text-xs font-mono text-neutral-500">01 / 03</span>
          </div>

          <div class="grid grid-cols-1 gap-10">
            {proyectosPrincipales.map(p => (
              <article class="group relative p-8 sm:p-10 rounded-3xl bg-neutral-900/60 border border-neutral-800/80 hover:border-neutral-600 transition-all duration-500 hover:shadow-2xl hover:-translate-y-1 backdrop-blur-md">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                  <div>
                    <h3 class="text-2xl sm:text-3xl font-bold text-white group-hover:text-indigo-300 transition-colors">
                      {p.titulo}
                    </h3>
                    <p class="text-sm font-mono text-neutral-400 mt-1">{p.subtitulo}</p>
                  </div>
                  {p.destacado && (
                    <span class="w-fit px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/30">
                      ★ Featured Project
                    </span>
                  )}
                </div>
                
                <p class="text-base text-neutral-300 leading-relaxed mb-8 font-light">
                  {p.descripcion}
                </p>

                {p.notaDiseno && (
                  <div class="mb-8 p-5 rounded-2xl border border-indigo-500/20 bg-indigo-500/5">
                    <p class="text-xs font-mono uppercase tracking-widest text-indigo-300 mb-2">Nota sobre la interfaz</p>
                    <p class="text-sm text-neutral-400 leading-relaxed">{p.notaDiseno}</p>
                  </div>
                )}

                {p.capturas && (
                  <div class="mb-8"><ImageCarousel images={p.capturas} label="Capturas del sistema" /></div>
                )}

                {p.flujo && (
                  <div class="mb-8 p-6 rounded-2xl border border-neutral-800 bg-neutral-950/70">
                    <p class="text-xs font-mono uppercase tracking-widest text-neutral-500 mb-5">Flujo principal del sistema</p>
                    <ol class="grid sm:grid-cols-4 gap-3">
                      {p.flujo.map((paso, index) => (
                        <li class="relative p-4 rounded-xl border border-neutral-800 bg-neutral-900 text-sm text-neutral-300">
                          <span class="block text-xs font-mono text-indigo-300 mb-2">0{index + 1}</span>
                          {paso}
                        </li>
                      ))}
                    </ol>
                    <p class="text-sm text-neutral-500 leading-relaxed mt-5">Las listas enlazadas mantienen los vuelos ordenados; pilas y colas modelan operaciones y estados sin recurrir a las colecciones nativas de Java.</p>
                  </div>
                )}

                <div class="flex flex-wrap gap-2.5 mb-8">
                  {p.tags.map(tag => (
                    <span class={`px-3 py-1.5 text-xs font-mono font-medium rounded-lg border ${tag.color}`}>
                      {tag.nombre}
                    </span>
                  ))}
                </div>

                <div class="flex flex-wrap items-center gap-6 text-sm font-semibold pt-6 border-t border-neutral-800/80">
                  {p.linkGithub && (
                    <a href={p.linkGithub} target="_blank" class="text-neutral-300 hover:text-white transition-colors flex items-center gap-2 group/link">
                      <span>Ver en GitHub</span>
                      <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                    </a>
                  )}
                  {p.linkDemo && (
                    <a href={p.linkDemo} target="_blank" class="text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-2 group/link">
                      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                      <span>Probar App Deployada</span>
                      <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- SECCIÓN 2: PROYECTOS PERSONALES ASISTIDOS POR IA -->
        <section class="space-y-12">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-neutral-800 pb-6">
            <div>
              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                Proyectos Personales con IA
              </h2>
              <p class="text-base text-neutral-400 mt-2">
                Experimentos creados mediante prompts y asistencia intensiva de IA, separados de mi experiencia técnica principal.
              </p>
            </div>
            <span class="text-xs font-mono text-neutral-500">02 / 03</span>
          </div>

          <div class="grid grid-cols-1 gap-8">
            {proyectosIA.map(p => (
              <article class="group relative p-8 sm:p-10 rounded-3xl bg-neutral-900/40 border border-neutral-800/60 hover:border-neutral-600 transition-all duration-500 hover:shadow-2xl hover:-translate-y-1 backdrop-blur-md">
                <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-indigo-300 transition-colors">{p.titulo}</h3>
                <p class="text-xs font-mono text-neutral-500 mb-4">{p.subtitulo}</p>
                <p class="text-base text-neutral-400 font-light leading-relaxed mb-6">{p.descripcion}</p>
                
                <div class="flex flex-wrap gap-2.5">
                  {p.tags.map(tag => (
                    <span class={`px-3 py-1.5 text-xs font-mono font-medium rounded-lg border ${tag.color}`}>
                      {tag.nombre}
                    </span>
                  ))}
                </div>

                <div class="mt-8 pt-6 border-t border-neutral-800/80">
                  <a href={p.linkShowcase} class="text-sm font-semibold text-neutral-300 hover:text-white transition-colors inline-flex items-center gap-2 group/link">
                    <span>Ver caso de estudio</span>
                    <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- SECCIÓN 3: TECH STACK Y HABILIDADES -->
        <section class="space-y-12">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-neutral-800 pb-6">
            <div>
              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                Habilidades & Tecnologías
              </h2>
              <p class="text-base text-neutral-400 mt-2">
                Herramientas y lenguajes que utilizo en el día a día.
              </p>
            </div>
            <span class="text-xs font-mono text-neutral-500">03 / 03</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {habilidades.map(group => (
              <div class="p-6 rounded-2xl bg-neutral-900/50 border border-neutral-800/60 space-y-4">
                <h3 class="text-sm font-mono text-neutral-400 uppercase tracking-wider">{group.categoria}</h3>
                <ul class="space-y-2">
                  {group.items.map(item => (
                    <li class="text-base text-neutral-200 font-medium flex items-center gap-2">
                      <span class="text-neutral-600">•</span> {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- FOOTER -->
        <footer class="pt-16 border-t border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-6 text-sm text-neutral-500 font-mono">
          <p>© 2026 Facundo Mesa — Montevideo, Uruguay</p>
          <div class="flex items-center gap-6">
            <a href="https://github.com/facumesa" target="_blank" class="hover:text-white transition-colors">GitHub</a>
            <a href="https://www.linkedin.com/in/facundomesati/" target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
          </div>
        </footer>

      </main>

    </div>
<ImageLightbox />

<canvas id="equalizer-canvas" class="fixed inset-0 pointer-events-none -z-10 opacity-20"></canvas>

<script>
  function getEqualizerCanvas(): HTMLCanvasElement {
    const element = document.getElementById('equalizer-canvas');
    if (!(element instanceof HTMLCanvasElement)) {
      throw new Error('No se encontró el canvas del ecualizador.');
    }
    return element;
  }

  function getCanvasContext(canvas: HTMLCanvasElement): CanvasRenderingContext2D {
    const context = canvas.getContext('2d');
    if (!context) {
      throw new Error('No se pudo inicializar el contexto 2D del canvas.');
    }
    return context;
  }

  const canvas = getEqualizerCanvas();
  const ctx = getCanvasContext(canvas);

  let width = 0;
  let height = 0;
  let mouse = { x: -1000, y: -1000 };

  // --- CONFIGURACIÓN DE TAMAÑO GRANDE ---
  const BAR_WIDTH = 36;          // Ancho de los bloques (mucho más gruesos)
  const BAR_GAP = 18;            // Espacio entre bloques
  const MAX_HEIGHT_RATIO = 0.85; // Altura máxima (hasta el 85% de la pantalla)
  const MIN_HEIGHT = 40;         // Altura mínima fija de reposo
  const CORNER_RADIUS = 8;       // Bordes ligeramente redondeados estilo card

  type EqualizerBar = {
    x: number;
    currentHeight: number;
    targetHeight: number;
    phase: number;
    speed: number;
  };

  let bars: EqualizerBar[] = [];

  function resize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    initBars();
  }

  function initBars() {
    bars = [];
    const barTotalWidth = BAR_WIDTH + BAR_GAP;
    const barCount = Math.ceil(width / barTotalWidth) + 1;

    for (let i = 0; i < barCount; i++) {
      bars.push({
        x: i * barTotalWidth,
        currentHeight: MIN_HEIGHT,
        targetHeight: MIN_HEIGHT,
        phase: Math.random() * Math.PI * 2,
        speed: 0.015 + Math.random() * 0.02
      });
    }
  }

  // Capturar posición del mouse
  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  window.addEventListener('mouseleave', () => {
    mouse.x = -1000;
    mouse.y = -1000;
  });

  window.addEventListener('resize', resize);
  resize();

  function animate() {
    ctx.clearRect(0, 0, width, height);

    const centerY = height / 2;
    const maxBarHeight = height * MAX_HEIGHT_RATIO;

    bars.forEach((bar) => {
      // 1. Ritmo suave en reposo
      bar.phase += bar.speed;
      const idleWave = (Math.sin(bar.phase) + 1) / 2;
      let calculatedTarget = MIN_HEIGHT + idleWave * (maxBarHeight * 0.15);

      // 2. Reacción al paso del cursor (área de efecto expandida)
      const barCenterX = bar.x + BAR_WIDTH / 2;
      const distPercentX = Math.abs(mouse.x - barCenterX);
      const distPercentY = Math.abs(mouse.y - centerY);

      const radiusX = 350; // Mayor rango de respuesta horizontal
      const radiusY = 450; // Mayor rango de respuesta vertical

      if (distPercentX < radiusX && distPercentY < radiusY) {
        const factorX = 1 - (distPercentX / radiusX);
        const factorY = 1 - (distPercentY / radiusY);
        const boost = factorX * factorY * (maxBarHeight - MIN_HEIGHT);
        calculatedTarget += boost;
      }

      // Transición fluida
      bar.targetHeight = calculatedTarget;
      bar.currentHeight += (bar.targetHeight - bar.currentHeight) * 0.08;

      // 3. Renderizado del rectángulo
      const barY = centerY - (bar.currentHeight / 2);

      // Gradiente sobrio estilo Tailwind
      const gradient = ctx.createLinearGradient(0, barY, 0, barY + bar.currentHeight);
      gradient.addColorStop(0, 'rgba(99, 102, 241, 0.6)');  // Indigo-500
      gradient.addColorStop(0.5, 'rgba(168, 85, 247, 0.75)'); // Purple-500
      gradient.addColorStop(1, 'rgba(99, 102, 241, 0.6)');

      ctx.fillStyle = gradient;

      // Rectángulo con esquinas redondeadas
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(bar.x, barY, BAR_WIDTH, bar.currentHeight, CORNER_RADIUS);
      } else {
        ctx.rect(bar.x, barY, BAR_WIDTH, bar.currentHeight);
      }
      ctx.fill();
    });

    requestAnimationFrame(animate);
  }

  animate();
</script>
  </body>
</html>
